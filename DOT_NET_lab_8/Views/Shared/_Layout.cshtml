<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f2f4f7; color: #222; }
        header { background: #183153; color: white; padding: 18px 5%; }
        header a { color: white; text-decoration: none; font-weight: bold; font-size: 20px; }
        main { max-width: 1000px; margin: 28px auto; padding: 24px; background: white; border-radius: 8px; }
        h1 { margin-top: 0; }
        .btn { display: inline-block; padding: 8px 13px; border-radius: 4px; background: #2459a9; color: white; text-decoration: none; border: 0; cursor: pointer; font-size: 14px; }
        .btn-danger { background: #b52b38; }
        .btn-secondary { background: #667085; }
        table { width: 100%; border-collapse: collapse; margin-top: 18px; }
        th, td { text-align: left; border-bottom: 1px solid #ddd; padding: 12px 10px; }
        th { background: #edf1f7; }
        label { display: block; font-weight: bold; margin: 14px 0 6px; }
        input { width: 100%; box-sizing: border-box; padding: 10px; border: 1px solid #bbb; border-radius: 4px; }
        .field-validation-error, .validation-summary-errors { color: #b42318; }
        .message { background: #e7f7ed; padding: 11px; border-radius: 4px; margin: 12px 0; }
        .actions a { margin-right: 6px; }
        footer { text-align: center; color: #666; padding: 18px; }
    </style>
</head>
<body>
<header><a asp-controller="Products" asp-action="Index">Inventory Management System</a></header>
<main>
    @RenderBody()
</main>
<footer>ASP.NET Core MVC • ADO.NET-style CRUD with SQLite</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
