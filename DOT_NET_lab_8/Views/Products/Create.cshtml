@model Product
@{
    ViewData["Title"] = "Add Product";
}
<h1>Add Product</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="ProductName"></label>
    <input asp-for="ProductName" />
    <span asp-validation-for="ProductName"></span>

    <label asp-for="Quantity"></label>
    <input asp-for="Quantity" type="number" min="0" />
    <span asp-validation-for="Quantity"></span>

    <label asp-for="Price"></label>
    <input asp-for="Price" type="number" min="0" step="0.01" />
    <span asp-validation-for="Price"></span>

    <p><button class="btn" type="submit">Add Product</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a></p>
</form>
