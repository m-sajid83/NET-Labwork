<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] - Placement Portal</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>body{background:#f4f7fb}.navbar{background:#172554}.navbar-brand,.nav-link{color:white!important}.card{border:0;border-radius:14px;box-shadow:0 4px 16px #0f172a12}.table thead th{background:#eaf0fb}</style></head>
<body><nav class="navbar navbar-expand-lg mb-4"><div class="container">
<a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">Placement Portal</a>
<div class="navbar-nav"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Dashboard" asp-action="CompanyDetails">Company Details</a></div>
</div></nav><main class="container pb-4">@RenderBody()</main>
<footer class="container text-center text-secondary py-3">© @DateTime.Now.Year - Placement Portal</footer></body></html>
