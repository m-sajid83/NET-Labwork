
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
</head>
<body style="font-family:Arial,sans-serif; padding:20px;">

    <header style="border-bottom:2px solid #333;
                   padding-bottom:10px; margin-bottom:20px;">
        <h2>My Feedback Portal</h2>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer style="border-top:1px solid #ccc;
                   padding-top:10px; margin-top:30px;">
        <p>© @DateTime.Now.Year - Simple Feedback System</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
