@model DOT_NET_lab_7.Models.Feedback

@{
    ViewData["Title"] = "Submit Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>We value your feedback</h3>

<form asp-controller="Feedback" asp-action="Create" method="post">
    <div style="margin-bottom:15px;">
        <label asp-for="Name"></label><br />
        <input asp-for="Name" />
        <span asp-validation-for="Name" style="color:red"></span>
    </div>

    <div style="margin-bottom:15px;">
        <label asp-for="Rating">Rating (1 to 5)</label><br />
        <input asp-for="Rating" type="number" min="1" max="5" />
        <span asp-validation-for="Rating" style="color:red"></span>
    </div>

    <div style="margin-bottom:15px;">
        <label asp-for="Description"></label><br />
        <textarea asp-for="Description" rows="4" cols="30"></textarea>
        <span asp-validation-for="Description" style="color:red"></span>
    </div>

    <button type="submit">Submit</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
